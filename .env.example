# Paper Trading Configuration
ACCOUNT_BALANCE=10000
ACCOUNT_CURRENCY=USD
TRADING_MODE=paper
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05
MAX_OPEN_POSITIONS=3
MAX_EXPOSURE=0.10
MAX_SPREAD_PIPS=2.0
MIN_STOP_DISTANCE_PIPS=5.0

# Market Data
DATA_SOURCE=csv
SYMBOL=EURUSD
TIMEFRAME=H1
CSV_DATA_PATH=data/eurusd_h1.csv

# Strategy
STRATEGY_VERSION=ema_atr_v1
EMA_FAST=12
EMA_SLOW=26
ATR_PERIOD=14
ATR_MULTIPLIER=1.5

# Database
DATABASE_PATH=nexapip.db

# Ollama (AI Learning)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Logging
LOG_LEVEL=INFO
LOG_FILE=nexapip.log

# Paper Kill Switch
PAPER_KILL_SWITCH_ENABLED=false
